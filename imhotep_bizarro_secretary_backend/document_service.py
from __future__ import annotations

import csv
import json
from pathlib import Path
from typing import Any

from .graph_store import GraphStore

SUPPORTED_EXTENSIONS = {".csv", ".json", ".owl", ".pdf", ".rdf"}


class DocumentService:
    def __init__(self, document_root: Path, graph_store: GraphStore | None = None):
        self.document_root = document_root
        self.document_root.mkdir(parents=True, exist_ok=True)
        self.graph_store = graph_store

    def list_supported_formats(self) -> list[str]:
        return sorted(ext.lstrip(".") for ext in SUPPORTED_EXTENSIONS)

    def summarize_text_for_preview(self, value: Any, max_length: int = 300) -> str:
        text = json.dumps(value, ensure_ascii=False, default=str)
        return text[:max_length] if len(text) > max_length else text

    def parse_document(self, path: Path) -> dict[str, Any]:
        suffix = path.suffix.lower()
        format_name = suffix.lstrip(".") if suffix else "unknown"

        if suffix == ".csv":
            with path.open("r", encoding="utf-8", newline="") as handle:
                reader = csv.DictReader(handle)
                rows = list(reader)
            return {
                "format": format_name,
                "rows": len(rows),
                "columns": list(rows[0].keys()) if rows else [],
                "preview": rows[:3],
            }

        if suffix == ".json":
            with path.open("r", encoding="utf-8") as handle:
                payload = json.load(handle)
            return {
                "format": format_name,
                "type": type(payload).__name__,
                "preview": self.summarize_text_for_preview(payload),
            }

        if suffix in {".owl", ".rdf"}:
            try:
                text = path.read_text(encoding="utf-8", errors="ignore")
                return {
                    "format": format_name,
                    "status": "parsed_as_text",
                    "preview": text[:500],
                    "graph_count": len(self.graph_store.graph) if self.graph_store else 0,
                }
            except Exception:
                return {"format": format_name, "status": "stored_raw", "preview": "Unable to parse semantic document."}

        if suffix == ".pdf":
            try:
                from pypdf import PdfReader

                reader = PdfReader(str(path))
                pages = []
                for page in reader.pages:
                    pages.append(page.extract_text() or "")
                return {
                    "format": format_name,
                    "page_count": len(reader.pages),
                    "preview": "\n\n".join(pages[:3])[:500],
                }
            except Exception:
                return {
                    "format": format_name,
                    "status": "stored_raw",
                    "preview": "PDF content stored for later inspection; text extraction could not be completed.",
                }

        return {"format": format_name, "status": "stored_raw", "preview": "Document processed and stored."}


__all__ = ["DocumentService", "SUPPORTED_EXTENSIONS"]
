            "candidates": candidates,
            "description": "Candidate communities for focused Type 2 Diabetes and medically underserved outreach.",
        }

    def query_type2_diabetes_chicago_underserved(self, community: str | None = None) -> list[dict[str, Any]]:
        base_query = """
            PREFIX med: <http://example.org/medical#>
            SELECT ?patient ?name ?neighborhood ?care_gap ?community WHERE {
                ?patient a med:Patient .
                ?patient med:hasName ?name .
                ?patient med:hasCondition med:Type2Diabetes .
                ?patient med:residesIn ?neighborhood .
                ?patient med:hasCareGap ?care_gap .
                ?patient med:isMedicallyUnderserved "true" .
                ?patient med:inCommunity ?community .
            }
            ORDER BY ?name
        """

        if community and community.lower() != "all":
            base_query = f"""
                PREFIX med: <http://example.org/medical#>
                SELECT ?patient ?name ?neighborhood ?care_gap ?community WHERE {{
                    ?patient a med:Patient .
                    ?patient med:hasName ?name .
                    ?patient med:hasCondition med:Type2Diabetes .
                    ?patient med:residesIn ?neighborhood .
                    ?patient med:hasCareGap ?care_gap .
                    ?patient med:isMedicallyUnderserved "true" .
                    ?patient med:inCommunity ?community .
                    FILTER(str(?community) = \"{community}\")
                }}
                ORDER BY ?name
            """

        results = []
        for row in self.graph.query(base_query):
            patient, name, neighborhood, care_gap, community_value = row
            patient_uri = str(patient)
            results.append(
                {
                    "patient_id": patient_uri.rsplit("/", 1)[-1],
                    "name": str(name),
                    "neighborhood": str(neighborhood),
                    "care_gap": str(care_gap),
                    "condition": "Type 2 Diabetes",
                    "community": str(community_value),
                }
            )
        return results

    def summary(self) -> dict[str, Any]:
        query = """
            PREFIX med: <http://example.org/medical#>
            SELECT (COUNT(DISTINCT ?patient) AS ?patient_count)
                   (COUNT(DISTINCT ?neighborhood) AS ?community_count)
            WHERE {
                ?patient a med:Patient .
                ?patient med:hasCondition med:Type2Diabetes .
                ?patient med:isMedicallyUnderserved "true" .
                ?patient med:residesIn ?neighborhood .
            }
        """

        row = next(iter(self.graph.query(query)), None)
        if row is None:
            return {"patient_count": 0, "community_count": 0, "city": "Chicago"}

        patient_count, community_count = row
        return {
            "patient_count": int(patient_count),
            "community_count": int(community_count),
            "city": "Chicago",
            "population_focus": "Type 2 Diabetes patients in medically underserved Chicago communities",
            "candidate_communities": self.community_candidates()["candidates"],
        }

    def export_json(self) -> str:
        records = self.query_type2_diabetes_chicago_underserved(community="Chicago")
        return json.dumps({"city": "Chicago", "patients": records}, indent=2)

    def export_csv(self) -> str:
        buffer = io.StringIO()
        fieldnames = ["patient_id", "name", "neighborhood", "community", "condition", "care_gap"]
        writer = csv.DictWriter(buffer, fieldnames=fieldnames)
        writer.writeheader()
        for patient in self.query_type2_diabetes_chicago_underserved(community="Chicago"):
            writer.writerow({
                "patient_id": patient["patient_id"],
                "name": patient["name"],
                "neighborhood": patient["neighborhood"],
                "community": patient["community"],
                "condition": patient["condition"],
                "care_gap": patient["care_gap"],
            })
        return buffer.getvalue()

    def export_rdf(self) -> str:
        return self.graph.serialize(format="xml")


__all__ = ["GraphStore"]
