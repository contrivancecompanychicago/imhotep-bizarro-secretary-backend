from __future__ import annotations

import csv
import io
import json
from pathlib import Path
from typing import Any

from rdflib import Graph, Literal, Namespace, RDF, URIRef


class GraphStore:
    def __init__(self, knowledge_dir: Path):
        self.knowledge_dir = knowledge_dir
        self.knowledge_dir.mkdir(parents=True, exist_ok=True)
        self.graph = Graph()
        self.med = Namespace("http://example.org/medical#")
        self.seed_underserved_chicago_cohort()
        self.load_default_sources()

    def load_default_sources(self) -> None:
        for path in sorted(self.knowledge_dir.glob("*")):
            if path.suffix.lower() in {".rdf", ".owl"}:
                try:
                    self.graph.parse(str(path), format="xml")
                except Exception:
                    continue

    def load_file(self, path: Path) -> None:
        if path.suffix.lower() in {".rdf", ".owl"}:
            try:
                self.graph.parse(str(path), format="xml")
            except Exception:
                pass

    def _add_patient_record(self, record: dict[str, str]) -> None:
        patient = URIRef(f"http://example.org/medical/{record['id']}")
        self.graph.add((patient, RDF.type, self.med.Patient))
        self.graph.add((patient, self.med.hasName, Literal(record["name"])))
        self.graph.add((patient, self.med.hasCondition, self.med.Type2Diabetes))
        self.graph.add((patient, self.med.residesIn, Literal(record["neighborhood"])))
        self.graph.add((patient, self.med.inCommunity, Literal(record["community"])))
        self.graph.add((patient, self.med.hasCareGap, Literal(record["care_gap"])))
        self.graph.add((patient, self.med.isMedicallyUnderserved, Literal("true")))
        if "priority" in record:
            self.graph.add((patient, self.med.hasPriority, Literal(record["priority"])))

