from __future__ import annotations

from pathlib import Path

from fastapi import FastAPI, File, HTTPException, UploadFile
from fastapi.responses import FileResponse, Response
from fastapi.staticfiles import StaticFiles

from .config import APP_NAME, VERSION
from .document_service import DocumentService
from .graph_store import GraphStore


def create_app(project_root: str | Path | None = None) -> FastAPI:
    project_root = Path(project_root) if project_root is not None else Path(__file__).resolve().parents[1]
    document_root = project_root / "data" / "documents"
    frontend_dir = project_root / "frontend"
    document_root.mkdir(parents=True, exist_ok=True)
    frontend_dir.mkdir(parents=True, exist_ok=True)

    app = FastAPI(title=APP_NAME, version=VERSION)
    graph_store = GraphStore(project_root / "data" / "knowledge")
    document_service = DocumentService(document_root, graph_store)

    app.mount("/static", StaticFiles(directory=str(frontend_dir)), name="static")

    @app.get("/")
    def serve_frontend() -> FileResponse:
        return FileResponse(frontend_dir / "medical-secretary.html")

    @app.get("/health")
    def health():
        return {"status": "ok", "service": APP_NAME, "version": VERSION}

    @app.get("/api/v0/documents")
    def list_documents():
        files = []
        for entry in sorted(document_root.iterdir()):
            if entry.is_file() and entry.suffix.lower() in {".csv", ".json", ".owl", ".pdf", ".rdf"}:
                files.append({
                    "filename": entry.name,
                    "format": entry.suffix.lower().lstrip("."),
                    "size_bytes": entry.stat().st_size,
                    "metadata": document_service.parse_document(entry),
                })
        return {"count": len(files), "formats": document_service.list_supported_formats(), "documents": files}

    @app.post("/api/v0/documents/update")
    async def update_document(file: UploadFile = File(...)):
        if not file.filename:
            raise HTTPException(status_code=400, detail="A filename is required.")

        suffix = Path(file.filename).suffix.lower()
        supported_ext = document_service.list_supported_formats()
        if suffix not in {f'.{ext}' for ext in supported_ext}:
            raise HTTPException(status_code=400, detail=f"Unsupported file type: {suffix}. Supported formats: {supported_ext}")

        target_dir = document_root / "uploads"
        target_dir.mkdir(parents=True, exist_ok=True)
        target_path = target_dir / file.filename
        content = await file.read()
        with target_path.open("wb") as handle:
            handle.write(content)

        metadata = document_service.parse_document(target_path)
        if suffix in {".owl", ".rdf"}:
            graph_store.load_file(target_path)

        return {
            "filename": target_path.name,
            "format": suffix.lstrip("."),
            "size_bytes": target_path.stat().st_size,
            "path": str(target_path),
            "metadata": metadata,
        }

    @app.get("/api/v0/graph/summary")
    def graph_summary():
        return graph_store.summary()

    @app.get("/api/v0/graph/candidates")
    def graph_candidates():
        return graph_store.community_candidates()

    @app.get("/api/v0/graph/patients")
    def graph_patients(community: str | None = None):
        patients = graph_store.query_type2_diabetes_chicago_underserved(community=community)
        return {"community": community or "Chicago", "count": len(patients), "patients": patients}

    @app.get("/api/v0/exports/{export_format}")
    def export_patients(export_format: str):
        format_name = export_format.lower()
        if format_name == "json":
            return Response(content=graph_store.export_json(), media_type="application/json", headers={"Content-Disposition": "attachment; filename=imhotep-bizarros-patients.json"})
        if format_name == "csv":
            return Response(content=graph_store.export_csv(), media_type="text/csv", headers={"Content-Disposition": "attachment; filename=imhotep-bizarros-patients.csv"})
        if format_name == "rdf":
            return Response(content=graph_store.export_rdf(), media_type="application/rdf+xml", headers={"Content-Disposition": "attachment; filename=imhotep-bizarros-patients.rdf"})
        raise HTTPException(status_code=400, detail="Unsupported export format. Use csv, json, or rdf.")

    @app.post("/api/v0/summary")
    def summarize_case(payload: dict):
        patient_name = payload.get("patient_name")
        return {"status": "success", "message": f"Clinical summary ready for {patient_name or 'patient'}", "version": VERSION}

    app.mount("/frontend", StaticFiles(directory=str(frontend_dir)), name="frontend")
    return app


__all__ = ["create_app"]
