    }


@app.get("/api/v0/exports/{export_format}")
def export_patients(export_format: str):
    format_name = export_format.lower()
    if format_name == "json":
        return Response(
            content=GRAPH_STORE.export_json(),
            media_type="application/json",
            headers={"Content-Disposition": "attachment; filename=imhotep-bizarros-patients.json"},
        )

    if format_name == "csv":
        return Response(
            content=GRAPH_STORE.export_csv(),
            media_type="text/csv",
            headers={"Content-Disposition": "attachment; filename=imhotep-bizarros-patients.csv"},
        )

    if format_name == "rdf":
        return Response(
            content=GRAPH_STORE.export_rdf(),
            media_type="application/rdf+xml",
            headers={"Content-Disposition": "attachment; filename=imhotep-bizarros-patients.rdf"},
        )

    raise HTTPException(status_code=400, detail="Unsupported export format. Use csv, json, or rdf.")


